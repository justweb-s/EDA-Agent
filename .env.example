# Environment
ENVIRONMENT=development

# LLM
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_MAX_RETRIES=3

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Checkpointing
CHECKPOINT_BACKEND=sqlite
SQLITE_PATH=./checkpoints_dev.db
CHECKPOINT_TTL_HOURS=72

# Kernel execution
KERNEL_EXECUTION_TIMEOUT=60
KERNEL_HEAVY_TIMEOUT=300
KERNEL_RESTART_ON_CRASH=true
KERNEL_MAX_OUTPUT_SIZE_MB=5.0

# Analysis
MAX_STEP_RETRIES=3
MAX_CRITIC_ITERATIONS=2
MANDATORY_SECTIONS=["data_quality","overview"]
NULL_WARNING_THRESHOLD=0.05
NULL_ERROR_THRESHOLD=0.30
OUTLIER_SIGMA_THRESHOLD=3.0
HIGH_CARDINALITY_THRESHOLD=20

# Memory management
CONTEXT_WINDOW_WARNING_PCT=0.80
SUMMARIZATION_KEEP_LAST_N=10
EXECUTION_HISTORY_MAX_SECTION_DETAIL=5

# HITL
HITL_DEFAULT_MODE=none
HITL_TIMEOUT_HOURS=24
HITL_TOUCHPOINTS=["plan_approval","critic_review"]

# Observability
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=eda-agent

LOG_LEVEL=INFO
LOG_FORMAT=json

ALERT_CHANNEL=log
ALERT_SLACK_WEBHOOK_URL=
ALERT_EMAIL_RECIPIENTS=[]

# API
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs
MAX_UPLOAD_SIZE_MB=100.0
SSE_BUFFER_SIZE=100
